# Maintainer: Narayan Silva <narayan.song@gmail.com>

pkgname=comm-gnome-theme-goldy-dark
pkgdesc="Goldy Dark GNOME theme com estilos GTK e wallpaper"
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL3')
url="https://github.com/big-comm/${pkgname}"
depends=('gtk3' 'gtk4' 'gnome-shell' 'gtk-engine-murrine')
makedepends=('git')
optdepends=('gnome-tweaks: Para customizações adicionais'
            'libheif: Para visualização do wallpaper no formato HEIC')

source=(
    "git+${url}.git"
)
sha256sums=('SKIP')

_theme_target='Goldy-Dark'

if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    tar -xf "${srcdir}/${pkgname}/usr/share/Goldy GTK Themes.tar.xz" -C "${srcdir}"
}

build() {
    echo "O tema '${_theme_target}' não requer passos de compilação."
}

package() {
    # Instala o tema GTK
    install -d "${pkgdir}/usr/share/themes"
    
    # [CORREÇÃO] O diretório de origem é 'Goldy GTK Themes', que é o próprio tema.
    local theme_source_dir="${srcdir}/Goldy GTK Themes"
    
    if [ ! -d "${theme_source_dir}" ]; then
        echo "Erro: Diretório do tema '${theme_source_dir}' não foi encontrado em '${srcdir}'!"
        return 1
    fi
    
    # Copia o diretório de origem e o RENOMEIA para o nome do tema alvo no destino.
    echo "Instalando '${theme_source_dir}' como '${_theme_target}'..."
    cp -r "${theme_source_dir}" "${pkgdir}/usr/share/themes/${_theme_target}"

    # Instala o wallpaper
    install -Dm644 "${srcdir}/${pkgname}/usr/share/goldy.heic" \
        "${pkgdir}/usr/share/backgrounds/${pkgname}/goldy.heic"

    # Instala documentação e licença
    install -Dm644 "${srcdir}/${pkgname}/README.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    
    install -Dm644 "${srcdir}/${pkgname}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
