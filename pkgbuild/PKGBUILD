# Maintainer: Narayan Silva <narayan.song@gmail.com>

pkgname=comm-gnome-theme-goldy-dark
pkgdesc="Goldy Dark GNOME theme com estilos GTK e wallpaper"
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL3')
url="https://github.com/big-comm/${pkgname}"
depends=('gtk3' 'gtk4' 'gnome-shell' 'gtk-engine-murrine')
makedepends=('git')
optdepends=('gnome-tweaks: Para customizações adicionais'
            'libheif: Para visualização do wallpaper no formato HEIC')

# [ALTERADO] A fonte agora é apenas o repositório do pacote
source=(
    "git+${url}.git"
)
sha256sums=('SKIP')

# Define a variante do tema a ser usada
_theme_target='Goldy-Dark'

# Detecta e usa o arquivo de instalação correto
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

# [NOVO] A função prepare extrai o tema do arquivo .tar.xz local
prepare() {
    # Extrai o tema para o diretório src
    tar -xf "${srcdir}/${pkgname}/usr/share/Goldy GTK Themes.tar.xz" -C "${srcdir}"
}

build() {
    echo "O tema '${_theme_target}' não requer passos de compilação."
}

package() {
    # Instala o tema GTK
    install -d "${pkgdir}/usr/share/themes"
    
    # [ALTERADO] O caminho agora aponta para o diretório extraído do tar.xz
    local theme_source_dir="${srcdir}/Goldy GTK Themes/${_theme_target}"
    
    if [ ! -d "${theme_source_dir}" ]; then
        echo "Erro: Diretório do tema '${_theme_target}' não encontrado após extração!"
        # Adiciona uma verificação para ajudar a depurar
        echo "Conteúdo de '${srcdir}':"
        ls -l "${srcdir}"
        return 1
    fi
    
    cp -r "${theme_source_dir}" "${pkgdir}/usr/share/themes/"

    # Instala o wallpaper
    install -Dm644 "${srcdir}/${pkgname}/usr/share/goldy.heic" \
        "${pkgdir}/usr/share/backgrounds/${pkgname}/goldy.heic"

    # Instala documentação e licença
    install -Dm644 "${srcdir}/${pkgname}/README.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    
    # [IMPORTANTE] Instala a licença original do tema
    # Você deve copiar o arquivo LICENSE do repositório de L4ki para a raiz do seu projeto
    install -Dm644 "${srcdir}/${pkgname}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
