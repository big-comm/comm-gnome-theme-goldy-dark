#!/usr/bin/env bash
# Helper para aplicar, atualizar ou remover o tema Goldy Dark, com backup/restauração.

set -e

# --- Configurações do Tema ---
THEME_NAME="Goldy-Dark"
WALLPAPER_NAME="goldy.heic"
PKG_NAME="comm-gnome-theme-goldy-dark"
# --- Fim das Configurações ---

WALLPAPER_PATH="/usr/share/backgrounds/${PKG_NAME}/${WALLPAPER_NAME}"
CONFIG_DIR="${HOME}/.config"
STATE_DIR="${CONFIG_DIR}/${PKG_NAME}"
STATE_GTK_THEME_FILE="${STATE_DIR}/previous_gtk_theme"
STATE_COLOR_FILE="${STATE_DIR}/previous_color_scheme"
STATE_WALL_FILE="${STATE_DIR}/previous_wallpaper_uri"
STATE_WALL_DARK_FILE="${STATE_DIR}/previous_wallpaper_uri_dark"
CONVERTED_WALLPAPER="${HOME}/.local/share/backgrounds/goldy-wallpaper.jpg"

mkdir -p "${STATE_DIR}" 2>/dev/null || true

# --- Funções de Mensagem ---
blueDark="\e[1;38;5;33m"; lightBlue="\e[1;38;5;39m"; cyan="\e[1;38;5;45m"; white="\e[1;97m"; reset="\e[0m"
printMsg() { echo -e "${blueDark}[${lightBlue}${PKG_NAME}${blueDark}]${reset} ${cyan}→${reset} ${white}$1${reset}"; }

# --- Funções de Backup e Restauração ---

# Salva o valor ATUAL de uma chave gsettings, mas APENAS se um backup já não existir.
# Isso preserva a configuração original do usuário através de múltiplas reinstalações.
save_gsettings_value() {
    local schema="$1" key="$2" backup_file="$3"
    if command -v gsettings &>/dev/null && [ ! -f "${backup_file}" ]; then
        local current_value
        current_value=$(gsettings get "${schema}" "${key}" 2>/dev/null || echo "''")
        printMsg "Backup: ${key} = ${current_value}"
        printf '%s\n' "${current_value}" > "${backup_file}"
    fi
}

# Restaura um valor a partir de um arquivo de backup e depois remove o backup.
restore_gsettings_value() {
    local schema="$1" key="$2" backup_file="$3"
    if command -v gsettings &>/dev/null && [ -f "${backup_file}" ]; then
        local previous_value
        previous_value=$(cat "${backup_file}")
        if gsettings set "${schema}" "${key}" "${previous_value}"; then
            printMsg "Restaurado: ${key} para ${previous_value}"
            rm -f "${backup_file}"
        fi
    fi
}

# --- Funções Principais ---

apply_theme() {
    printMsg "Iniciando aplicação do tema Goldy Dark..."
    
    # 1. Faz backup das configurações atuais ANTES de alterá-las
    save_gsettings_value "org.gnome.desktop.interface" "gtk-theme" "${STATE_GTK_THEME_FILE}"
    save_gsettings_value "org.gnome.desktop.interface" "color-scheme" "${STATE_COLOR_FILE}"
    save_gsettings_value "org.gnome.desktop.background" "picture-uri" "${STATE_WALL_FILE}"
    save_gsettings_value "org.gnome.desktop.background" "picture-uri-dark" "${STATE_WALL_DARK_FILE}"

    # 2. Aplica as novas configurações
    printMsg "Aplicando novo tema GTK: ${THEME_NAME}"
    gsettings set org.gnome.desktop.interface gtk-theme "${THEME_NAME}"
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

    # 3. Aplica o wallpaper (com conversão se necessário)
    if [ -f "${WALLPAPER_PATH}" ]; then
        printMsg "Aplicando novo wallpaper..."
        local target_path="${WALLPAPER_PATH}"
        if [[ "${WALLPAPER_PATH}" == *.heic ]] && command -v heif-convert &>/dev/null; then
            mkdir -p "$(dirname "${CONVERTED_WALLPAPER}")"
            if heif-convert "${WALLPAPER_PATH}" "${CONVERTED_WALLPAPER}" >/dev/null; then
                target_path="${CONVERTED_WALLPAPER}"
            fi
        fi
        gsettings set org.gnome.desktop.background picture-uri "file://${target_path}"
        gsettings set org.gnome.desktop.background picture-uri-dark "file://${target_path}"
    fi
    
    printMsg "Tema Goldy Dark aplicado com sucesso!"
}

remove_theme() {
    printMsg "Iniciando remoção do tema Goldy Dark..."
    
    # 1. Restaura todas as configurações a partir dos backups
    restore_gsettings_value "org.gnome.desktop.interface" "gtk-theme" "${STATE_GTK_THEME_FILE}"
    restore_gsettings_value "org.gnome.desktop.interface" "color-scheme" "${STATE_COLOR_FILE}"
    restore_gsettings_value "org.gnome.desktop.background" "picture-uri" "${STATE_WALL_FILE}"
    restore_gsettings_value "org.gnome.desktop.background" "picture-uri-dark" "${STATE_WALL_DARK_FILE}"

    # 2. Limpa arquivos temporários
    if [ -f "${CONVERTED_WALLPAPER}" ]; then
        rm -f "${CONVERTED_WALLPAPER}"
    fi
    
    printMsg "Configurações originais do usuário restauradas."
}

# --- Lógica de Execução ---
case "$1" in
    --install|--apply|--upgrade) apply_theme ;;
    --uninstall|--remove) remove_theme ;;
    *) 
        echo "Uso: $0 [--install|--uninstall]"
        exit 1 
        ;;
esac
